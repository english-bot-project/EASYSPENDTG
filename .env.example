# Namuna fayl. Nusxa oling, nomini .env qiling va haqiqiy qiymatlarni yozing.
# Railway'da bu qiymatlar .env emas, Variables bo'limiga kiritiladi.

BOT_TOKEN=BotFather_bergan_yangi_token
GEMINI_API_KEY=Gemini_kaliti

# Sizning Telegram ID raqamingiz (/admins, /send va zaxira nusxa uchun). @userinfobot dan bilib oling.
ADMIN_ID=123456789

# Mini App manzili. Railway'da domen yaratgach yoziladi, masalan https://easyspend-production.up.railway.app
# (Railway domenini o'zi beradi, ko'p holda yozish shart emas)
WEBAPP_URL=

# Bazani saqlash joyi. Railway'da Volume /data ga ulansa: /data/bot.db
# DB_PATH=/data/bot.db
